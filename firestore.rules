rules_version = '2';

/* =========================================================
   CESS — Firestore Security Rules
   =========================================================
   Paste this entire file into: Firebase Console > Firestore
   Database > Rules tab > Publish.

   PRINCIPLE: Never trust the client. Every rule below assumes
   a malicious user can read/edit any HTML, CSS, or JavaScript
   in this project and call Firestore directly from the browser
   console. Security lives here, not in hidden buttons.
   ========================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helper functions ---------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isMember() {
      return role() == "member";
    }

    function isLeadership() {
      return role() == "leadership";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isLeadershipOrAdmin() {
      return isLeadership() || isAdmin();
    }

    function isAnyRole() {
      return isMember() || isLeadershipOrAdmin();
    }

    /* ---------- users/{uid} ---------- */
    /* Each user may read/update only their own document, and may
       NEVER change their own role field. Admin can read and update
       any user document (for role assignment). Leadership can read
       (needed for the "registered students" aggregate context and
       committee coordination) but not write other users' documents. */

    match /users/{uid} {
      allow get: if isAdmin() || isLeadershipOrAdmin() || (isSignedIn() && request.auth.uid == uid);
      // Listing the full collection is restricted to admin/leadership only —
      // the public site must never enumerate all user documents.
      allow list: if isAdmin() || isLeadership();

      // A user may create their OWN document at signup, but role must be "member".
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "member";

      // A user may update their own document but must NOT change their role.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    /* ---------- settings/publicStatistics ---------- */
    /* Public can read the pre-computed aggregate only. Only admin
       can write it. This avoids exposing the full users collection
       publicly just to compute a count (see spec section 11). */

    match /settings/publicStatistics {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- settings/socialLinks ---------- */
    /* Public can read configured social links. Only admin can edit. */

    match /settings/socialLinks {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* Catch-all for any other settings docs — admin only, not publicly readable */
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ---------- activities/{activityId} ---------- */
    /* Public may read ONLY published activities. Leadership/Admin
       may read all (including drafts) and manage them. Members
       cannot create/edit/delete activities.

       NOTE ON LIST RULES (verified against Firebase's official
       "Securely query data" documentation): Firestore evaluates a
       `list` request against the query's potential result set, not
       per-document — a query is all-or-nothing, so `resource.data`
       IS meaningful in a list rule (Firestore checks it would hold
       for every document the query could possibly return). This
       means a public query MUST include `.where("published","==",true)`
       as an actual query constraint (see app.js) — the rule below
       then guarantees every possible result satisfies it. A public
       query that omits that constraint is rejected outright, which
       is the safe failure mode: no accidental data leak, just an
       error surfaced to console (caught by safeFetch(), which shows
       the graceful empty state rather than breaking the page). */

    match /activities/{activityId} {
      allow get: if (resource.data.published == true) || isLeadershipOrAdmin();
      allow list: if isLeadershipOrAdmin()
                  || (resource.data.published == true && request.query.limit <= 50);
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    /* ---------- announcements/{announcementId} ---------- */

    match /announcements/{announcementId} {
      allow get: if (resource.data.published == true) || isLeadershipOrAdmin();
      allow list: if isLeadershipOrAdmin()
                  || (resource.data.published == true && request.query.limit <= 50);
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    /* ---------- resources/{resourceId} ---------- */

    match /resources/{resourceId} {
      allow get: if (resource.data.published == true) || isLeadershipOrAdmin();
      allow list: if isLeadershipOrAdmin()
                  || (resource.data.published == true && request.query.limit <= 50);
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    /* ---------- publicArchive/{itemId} ---------- */
    /* Fully public archive — no private info should ever be stored here. */

    match /publicArchive/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ---------- history/{entryId} ---------- */
    /* Fully public timeline content, editable only by admin (leadership may propose changes via admin, per spec section 22 "authorized users"). */

    match /history/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ---------- Private Leadership Archive ----------
       committees, meetings, reports, internalDocuments, handover
       Members and the public can NEVER read these. Leadership can
       read/write; Admin can read/write/delete everything. */

    match /committees/{docId} {
      allow read: if isLeadershipOrAdmin();
      allow create, update: if isLeadershipOrAdmin();
      allow delete: if isAdmin();
    }

    match /meetings/{docId} {
      allow read: if isLeadershipOrAdmin();
      allow create, update: if isLeadershipOrAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{docId} {
      allow read: if isLeadershipOrAdmin();
      allow create, update: if isLeadershipOrAdmin();
      allow delete: if isAdmin();
    }

    match /internalDocuments/{docId} {
      allow read: if isLeadershipOrAdmin();
      allow create, update: if isLeadershipOrAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- handover/{docId} ----------
       Extra-sensitive: contains account/config handover notes.
       Admin only — even leadership does not get default write access,
       though admin may grant broader access later if needed. */

    match /handover/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ---------- Default deny ----------
       Any collection not explicitly listed above is closed by default. */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
