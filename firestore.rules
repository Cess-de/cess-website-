rules_version = '2';

// ============================================================================
// CESS — Firestore Security Rules
//
// Role model: every authenticated user has a document at /users/{uid} with
// a `role` field of 'member', 'leadership', or 'admin'. These rules read
// that document to authorize every request. Client-side UI hiding is never
// trusted — every collection below enforces access here, server-side.
//
// IMPORTANT — first admin setup:
// No one can promote themselves. The very first admin must be set manually:
//   1. Have that person sign up normally through login.html (creates a
//      'member' user + /users/{uid} doc).
//   2. In the Firebase Console, go to Firestore Database → users → find
//      their document by email → edit the `role` field to "admin".
// From then on, that admin can promote others from the Users & Roles panel.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper functions
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return isSignedIn() && userDoc().data.role != null ? userDoc().data.role : 'none';
    }

    function isMember() {
      return isSignedIn() && userRole() in ['member', 'leadership', 'admin'];
    }

    function isLeadership() {
      return isSignedIn() && userRole() in ['leadership', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    // ------------------------------------------------------------------
    // users — profile documents (no passwords stored here; Firebase Auth
    // handles credentials separately)
    // ------------------------------------------------------------------
    match /users/{userId} {
      // A signed-in user can read their own profile; leadership/admin can
      // read any profile (needed for membership lists, dashboards).
      allow read: if isSignedIn() && (request.auth.uid == userId || isLeadership());

      // Anyone creating their OWN account document may do so, but only
      // with role fixed to 'member' — prevents self-promotion at signup.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'member'
                    && request.resource.data.uid == userId;

      // A user may update their own non-role fields (e.g. cohort display
      // name) but can NEVER change their own role.
      // An admin may update any user's document, including role, but can
      // never change their own role via this path (prevents accidental
      // self-lockout logic being relied on — still allowed technically,
      // but the important protection is that non-admins cannot touch role).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role)
        ||
        (isAdmin() && request.auth.uid != userId)
      );

      // Only admins may delete user records.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // announcements — audience: 'public' | 'member'
    // ------------------------------------------------------------------
    match /announcements/{id} {
      allow read: if resource.data.audience == 'public' || isMember();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // activities — public read (activities are always public-facing)
    // ------------------------------------------------------------------
    match /activities/{id} {
      allow read: if true;
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // resources — visibility: 'public' | 'member'
    // ------------------------------------------------------------------
    match /resources/{id} {
      allow read: if resource.data.visibility == 'public' || isMember();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // publicArchive — always public read; only leadership/admin can write.
    // This collection is intentionally separate from internal collections
    // so a public page can never accidentally query private data.
    // ------------------------------------------------------------------
    match /publicArchive/{id} {
      allow read: if true;
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // committees — public read (rosters are not sensitive), leadership write
    // ------------------------------------------------------------------
    match /committees/{id} {
      allow read: if true;
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // meetings — internal only
    // ------------------------------------------------------------------
    match /meetings/{id} {
      allow read: if isLeadership();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // reports — internal only
    // ------------------------------------------------------------------
    match /reports/{id} {
      allow read: if isLeadership();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // internalDocuments — internal only, never public
    // ------------------------------------------------------------------
    match /internalDocuments/{id} {
      allow read: if isLeadership();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // handover — internal only, the most sensitive collection
    // ------------------------------------------------------------------
    match /handover/{id} {
      allow read: if isLeadership();
      allow create, update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // contactMessages — public can create (submit the contact form) but
    // never read; only leadership/admin can read or manage messages.
    // ------------------------------------------------------------------
    match /contactMessages/{id} {
      allow create: if true;
      allow read: if isLeadership();
      allow update, delete: if isLeadership();
    }

    // ------------------------------------------------------------------
    // Default deny — any collection not explicitly listed above is
    // inaccessible. Add new collections deliberately above this line.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
